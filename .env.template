# Copy to .env for local runs (never commit .env). In GitHub, add these as
# Settings -> Secrets and variables -> Actions -> Secrets instead.

# Required: token of your Metaculus BOT account (https://www.metaculus.com/futureeval/participate/)
METACULUS_TOKEN=REPLACE_ME

# Required: OpenRouter key (free tournament credits: https://forms.gle/aQdYMq9Pisrf1v7d8)
OPENROUTER_API_KEY=REPLACE_ME

# Recommended: AskNews (free for FutureEval participants; renew each season)
# ASKNEWS_CLIENT_ID=
# ASKNEWS_SECRET=
# or: ASKNEWS_API_KEY=

# Optional: FRED API key (free, https://fred.stlouisfed.org/docs/api/api_key.html).
# Without it the bot uses FRED's public CSV download, which normally works too.
# FRED_API_KEY=

# Optional tuning (GitHub: Settings -> Secrets and variables -> Actions -> Variables)
# NEXORA_PROFILE=standard              # lean | standard | max | claude-only
# NEXORA_MINIBENCH_PROFILE=lean        # profile used for MiniBench questions
# NEXORA_FORECASTERS=anthropic/claude-opus-5.5:high,openai/gpt-6-sol:high   # replaces the profile's ensemble
# NEXORA_BINARY_CAP=0.02               # never below 2% or above 98%
# NEXORA_CALIB_A=1.0                   # recalibration; see scripts/fit_calibration.py
# NEXORA_CALIB_B=0.0
# NEXORA_PAUSED=true                   # (GitHub variable) pauses the scheduled workflow
